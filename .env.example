# Copy this file to .env and adjust if your local setup differs.

# --- Document loading ---
CORPUS_DIR=C:/Users/Dell/Downloads/AI training/pdf/pdf
MAX_PDF_FILES=5

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Embeddings (local Ollama) ---
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# --- Local LLM used by ask.py for the final answer step ---
LLM_MODEL=llama3.2
TOP_K=4

# --- Postgres + pgvector ---
# Local Postgres uses "trust" auth for localhost (see pg_hba.conf), so this
# password isn't actually verified by the server -- any value works here.
# If you point this at a different Postgres instance with real auth, put
# the real password in your own .env (never commit it).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aventro_rag_db
TABLE_NAME=document_chunks
